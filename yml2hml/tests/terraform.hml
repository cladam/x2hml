// Infrastructure Configuration for Terraform Module
cluster-name: "production_aws_cluster"
region: "us-east-1"
environment: "prod"
// Networking & Multi-AZ
availability-zones: ["us-east-1a", "us-east-1b", "us-east-1c"]
vpc-cidr: "10.0.0.0/16"
// Node Pool Scaling Configuration
@scaling-policy {
    min-capacity: 2
    max-capacity: 10
    desired-capacity: 4
    cpu-threshold-percentage: 75.5
}
// Security Groups & Firewall Rules (Flow Mappings)
@ingress-rules {
    port: 80
    protocol: "TCP"
    cidr: "0.0.0.0/0"
    description: "HTTP traffic"
}
@ingress-rules {
    port: 443
    protocol: "TCP"
    cidr: "0.0.0.0/0"
    description: "HTTPS traffic"
}
@ingress-rules {
    port: 22
    protocol: "TCP"
    cidr: "10.0.0.0/8"
    description: "Internal SSH access"
}
// Database Settings
@database-config {
    db-name: "main_db"
    allocated-storage-gb: 100
    multi-az: true
    auto-minor-version-upgrade: true
    backup-retention-days: 14
    deletion-protection: false
    maintenance-window: null
}
// EC2 Instance User-Data Startup Script (Multi-line Block Scalar)
user-data-script: """
#!/bin/bash
set -euo pipefail
echo "Initializing node for x2hml cluster..."
systemctl start docker
echo "Done!"
"""
