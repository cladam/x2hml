    ((block ++ rest.fst), rest.snd)

// .hc:434
pub fun hc_convert_scalar_key(after : string, hkey : string, pad : string, st2 : convertstate, parent_indent : int, depth : int)
  if hc_is_flow_map(after) then
    val out_line : string = (pad ++ hc_convert_flow_map(after, hkey))
    val rest : (list<string>, convertstate) = hc_convert_block(st2, parent_indent, depth)
    (([out_line] ++ rest.fst), rest.snd)
  else
    val hval : string = hc_hml_value(after)
    val out_line : string = (((pad ++ hkey) ++ ": ") ++ hval)
    val rest : (list<string>, convertstate) = hc_convert_block(st2, parent_indent, depth)
    (([out_line] ++ rest.fst), rest.snd)

// .hc:448
pub fun hc_convert_key(trimmed : string, pad : string, st : convertstate, parent_indent : int, depth : int)
  val sep : int = hc_find_key_sep(trimmed)
  if (sep >= 0) then
    val key : string = trimmed.list.take(sep).string
    val hkey : string = hc_to_hml_key(key)
    val after : string = hc_strip_inline_comment(hc_strip(trimmed.list.drop((sep + 1)).string))
    val st2 : convertstate = hc_advance(st)
    if hc_is_block_scalar(after) then
      hc_convert_block_scalar_key(hkey, pad, st2, parent_indent, depth)
    else if (after == "") then hc_convert_nested_key(hkey, pad, st2, parent_indent, depth) else hc_convert_scalar_key(after, hkey, pad, st2, parent_indent, depth)
  else
    val st2 : convertstate = hc_advance(st)
    val rest : (list<string>, convertstate) = hc_convert_block(st2, parent_indent, depth)
    (([((pad ++ "// ? ") ++ trimmed)] ++ rest.fst), rest.snd)

// .hc:466
pub fun hc_convert_block(st : convertstate, parent_indent : int, depth : int)
  if hc_done(st) then
    ([], st)
  else
    val line : string = hc_current_line(st)
    val trimmed : string = hc_strip(line)
    val indent : int = hc_count_indent(line)
    if (indent < parent_indent) then
      ([], st)
    else if (indent > parent_indent) then
      ([], st)
    else if (trimmed == "") then
      hc_convert_block(hc_advance(st), parent_indent, depth)
    else
      val pad : string = hc_make_pad(depth)
      if hc_has_prefix(trimmed, "#") then
        hc_convert_comment(trimmed, pad, st, parent_indent, depth)
      else if hc_has_prefix(trimmed, "- ") then hc_convert_list_line(st, parent_indent, depth) else hc_convert_key(trimmed, pad, st, parent_indent, depth)

// .hc:484
pub fun hc_yaml_to_hml(input : string)
  val raw_lines : list<string> = hc_lines(input)
  val st : convertstate = hc_make_state(raw_lines)
  val result : (list<string>, convertstate) = hc_convert_block(st, 0, 0)
  result.fst.join("\n")
